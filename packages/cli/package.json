{
  "name": "@bpmn-script/cli",
  "description": "Command line interface compiling BPMNscript to BPMN 2.0 XML and back",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BPMNscript/bpmnscript.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.2.3"
  },
  "files": [
    "bin",
    "out",
    "src"
  ],
  "bin": {
    "bpmns": "./bin/cli.js"
  },
  "scripts": {
    "prepack": "node -e \"fs.cpSync('../../LICENSE', 'LICENSE')\"",
    "clean": "node -e \"for (const f of [...fs.globSync('*.tsbuildinfo'), 'out']) fs.rmSync(f, { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -b tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bpmn-script/language": "0.1.0",
    "@bpmn-script/transform": "0.1.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "langium": "^4.4.0"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}

{
  "name": "@bpmn-script/transform",
  "description": "IR type definitions and bidirectional BPMN transforms for BPMNscript",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BPMNscript/bpmnscript.git",
    "directory": "packages/transform"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.2.3"
  },
  "files": [
    "out",
    "src"
  ],
  "main": "./out/index.js",
  "module": "./out/index.js",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "out/index"
      ]
    }
  },
  "scripts": {
    "prepack": "node -e \"fs.cpSync('../../LICENSE', 'LICENSE')\"",
    "clean": "node -e \"for (const f of [...fs.globSync('*.tsbuildinfo'), 'out']) fs.rmSync(f, { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && node -e \"fs.cpSync('src/operaton-moddle.json', 'out/operaton-moddle.json')\"",
    "build:post": "node -e \"fs.cpSync('src/operaton-moddle.json', 'out/operaton-moddle.json')\"",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -b tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bpmn-script/language": "0.1.1",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-moddle": "^10.3.1",
    "langium": "^4.4.0",
    "saxen": "^11.1.0"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}

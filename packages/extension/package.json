{
  "name": "vscode-bpmnscript",
  "description": "VS Code extension for BPMNscript, bundling the Langium language server",
  "version": "0.1.1",
  "displayName": "BPMNscript",
  "publisher": "bpmnscript",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/BPMNscript/bpmnscript.git",
    "directory": "packages/extension"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "bpmn-script",
        "aliases": [
          "BPMNscript",
          "bpmn-script"
        ],
        "extensions": [
          ".bpmnscript"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bpmn-script",
        "scopeName": "source.bpmn-script",
        "path": "syntaxes/bpmn-script.tmLanguage.json"
      },
      {
        "scopeName": "bpmn-script.injection",
        "path": "syntaxes/bpmn-script.injection.tmLanguage.json",
        "injectTo": [
          "source.bpmn-script"
        ]
      }
    ],
    "commands": [
      {
        "command": "bpmnscript.compile",
        "title": "Compile to BPMN",
        "category": "BPMNscript"
      },
      {
        "command": "bpmnscript.decompile",
        "title": "Decompile to BPMNscript",
        "category": "BPMNscript"
      },
      {
        "command": "bpmnscript.openAndDecompile",
        "title": "Open a BPMN file and convert it...",
        "category": "BPMNscript"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bpmnscript",
          "title": "BPMNscript",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "bpmnscript": [
        {
          "type": "webview",
          "id": "bpmnscript.sidebar",
          "name": "Convert",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "bpmnscript.compile",
          "when": "resourceExtname == .bpmnscript"
        },
        {
          "command": "bpmnscript.decompile",
          "when": "resourceExtname == .bpmn"
        },
        {
          "command": "bpmnscript.openAndDecompile"
        }
      ]
    }
  },
  "main": "./out/extension/main.cjs",
  "scripts": {
    "clean": "node -e \"for (const f of [...fs.globSync('*.tsbuildinfo'), 'out', 'syntaxes']) fs.rmSync(f, { recursive: true, force: true })\"",
    "vscode:prepublish": "npm run build",
    "build:prepare": "node -e \"fs.cpSync('../language/syntaxes/bpmn-script.tmLanguage.json', 'syntaxes/bpmn-script.tmLanguage.json'); fs.cpSync('injection/bpmn-script.injection.tmLanguage.json', 'syntaxes/bpmn-script.injection.tmLanguage.json'); fs.cpSync('../../LICENSE', 'LICENSE')\"",
    "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
    "build:post": "npm run build:prepare && node esbuild.mjs",
    "build:clean": "npm run clean && npm run build",
    "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\"",
    "typecheck": "tsc -b tsconfig.test.json",
    "test": "vitest run",
    "package": "vsce package"
  },
  "dependencies": {
    "@bpmn-script/language": "0.1.1",
    "@bpmn-script/transform": "0.1.1",
    "langium": "^4.4.0",
    "vscode-languageclient": "~10.1.2"
  },
  "devDependencies": {
    "@types/vscode": "~1.140.0",
    "@vscode/vsce": "^4.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "~0.28.2",
    "vitest": "^5.0.5"
  },
  "vsce": {
    "dependencies": false
  }
}

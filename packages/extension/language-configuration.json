{
  "comments": {
    // single-line comment marker
    "lineComment": "//",
    // block comment markers
    "blockComment": ["/*", "*/"]
  },
  // the ID terminal in bpmn-script.langium, so a hyphenated name selects whole
  "wordPattern": "[_a-zA-Z]\\w*(-\\w+)*",
  // symbols used as brackets
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  // symbols that are auto closed when typing
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  // symbols that can be used to surround a selection
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ]
}

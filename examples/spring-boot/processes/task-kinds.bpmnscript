// The engine walks straight past the `step`, runs the `send` and `decide`
// bindings, and parks at the `receive` until a message is correlated; the user
// task after it makes the released instance visible. The `decide` binds to a
// class rather than a decision table, so no DMN artifact is needed.

process task-kinds(label: "Task kinds") {
  start OrderPlaced

  step RecordIntent(label: "Record the intent")

  send NotifyWarehouse(label: "Notify the warehouse", class: "com.example.demo.LogDelegate")

  decide RateOrder(label: "Rate the order", class: "com.example.demo.LogDelegate")

  receive AwaitShipment(label: "Wait for the shipment notice", message: "ShipmentDispatched")

  user ConfirmDelivery(label: "Confirm the delivery", assignee: "demo")

  end OrderClosed
}

// Nightly report: two job settings and a shell task, three things an XML
// comparison cannot show the engine doing. The two gather steps run on parallel branches
// and their join carries `joinAsyncBefore`, so each arriving token parks a job
// at the join until the job executor runs it. The count step repeats three
// times with `runAsyncBefore`, so each run parks a job of its own rather than
// one job around the repetition. The last step is a shell task the engine runs
// itself: `echo report-host`, whose output and exit code land in the two
// variables the fields name.
//
// The shell command is `echo`, which every image the fixture builds on ships,
// so the process runs on the demo profile without additional Java classes.

process nightly-report(label: "Nightly report") {
  start NightlyRun

  parallel (joinAsyncBefore: true) {
    {
      step GatherSales(label: "Gather the sales figures")
    }
    {
      step GatherStock(label: "Gather the stock levels")
    }
  }

  step CountEntries for 3(label: "Count the report entries", runAsyncBefore: true)

  service RecordHost(label: "Record the reporting host", type: "shell") {
    field command = "echo"
    field arg1 = "report-host"
    field outputVariable = "reportHost"
    field errorCodeVariable = "reportHostExit"
  }

  end ReportBuilt
}

process engine-extensions(label: "Engine extension surface") {
  start ExtensionsRequested

  service RecordMarkers(label: "Record the lifecycle markers", class: "com.example.demo.LogDelegate") {
    field marker = "recorded-${1+1}"
    on start(class: "com.example.demo.RecordingExecutionListener") {
      field marker = "${execution.processInstanceId}"
    }
    on end(class: "com.example.demo.RecordingExecutionListener")
  }

  service EchoParameters(
    label: "Echo the mapped parameters",
    expression: "${reviewerHint}/${routing.desk}/${routing.priority}",
    resultVariable: "parameterEcho"
  ) {
    input reviewerHint = "match every receipt against the trip dates"
    input routing = { "desk": "expenses-l2", "priority": "high" }
    output mappedDesk = "${routing.desk}"
  }

  user ConfirmMarkers(
    label: "Confirm the recorded markers",
    assignee: "demo",
    formRef: "confirm-markers",
    version: 1
  ) {
    on create(class: "com.example.demo.RecordingTaskListener") {
      field marker = "confirmed"
    }
  }

  service SettleExtensions(label: "Settle behind the transaction boundary", class: "com.example.demo.LogDelegate", asyncBefore: true)

  end ExtensionsRecorded
}

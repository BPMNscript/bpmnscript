process loan-approval(label: "Loan Approval") {
  var amount: number
  var creditScore: number
  var risk: string
  var approved: boolean

  start RequestReceived(label: "Loan request received") {
    form {
      amount: number "Loan amount"
      creditScore: number "Credit score"
    }
  }

  // Small loans are screened by an automated risk assessment.
  if (amount < 10000) {
    service AssessRisk(label: "Assess risk", class: "com.example.loan.RiskAssessmentDelegate")
  }

  // A low-risk small loan is approved automatically; everything else
  // (large loans, or small loans that are not low-risk) needs a human decision.
  if (amount < 10000 && risk == "low") {
    service AutoApprove(label: "Auto-approve", class: "com.example.loan.AutoApproveDelegate")
  } else {
    user Approve(label: "Approve loan", assignee: "demo") {
      form {
        approved: boolean "Approve the loan?"
      }
    }
  }

  if (approved == true) {
    service NotifyAccepted(label: "Notify accepted", class: "com.example.loan.AcceptDelegate")
  } else {
    service NotifyRejected(label: "Notify rejected", class: "com.example.loan.RejectDelegate")
  }

  end Done(label: "Loan request handled")
}

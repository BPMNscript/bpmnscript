// The token parks at the `await` until an outside system correlates the
// confirmation back. There is no user task in between, so only the message
// releases the instance.

process awaiting-confirmation {
  start RequestSubmitted

  service SubmitRequest(label: "Submit the request", class: "com.example.demo.LogDelegate")

  await message("ConfirmationReceived")

  service FinalizeRequest(label: "Finalize the request", class: "com.example.demo.LogDelegate")

  end RequestCompleted
}

// Started with `failCharge` set, the charge delegate throws the declared
// error, and the `emit compensation` in the process-level handler unwinds the
// reservation subprocess that had already completed.

process compensating-saga {
  error CHARGE_FAILED(message: "The payment charge could not be completed")

  start BookingStarted

  subprocess ReserveSeat(label: "Reserve the seat") {
    service ReserveSeatTask(label: "Reserve the seat", class: "com.example.demo.LogDelegate")

    on compensation {
      service ReleaseSeat(label: "Release the seat", class: "com.example.demo.LogDelegate")
    }
  }

  service ChargeCard(label: "Charge the customer's card", class: "com.example.demo.FailingChargeDelegate")

  end BookingConfirmed

  on error(CHARGE_FAILED) {
    emit compensation CompensationTriggered
    end CompensationHandled
  }
}

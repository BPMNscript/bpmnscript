process order-reminder {
  start OrderPlaced
  user ReviewOrder(label: "Review order", assignee: "demo")

  subprocess Fulfil(label: "Fulfil the order") {
    service PickItems(label: "Pick the items", class: "com.example.demo.LogDelegate")
    service PackItems(label: "Pack the items", class: "com.example.demo.LogDelegate")

    on timer("PT1H", alongside) {
      user ChaseWarehouse(label: "Chase the warehouse", assignee: "demo")
    }
  }

  end OrderShipped

  on message("OrderCancelled") {
    service CancelOrder(label: "Cancel the order", class: "com.example.demo.LogDelegate")
  }
}

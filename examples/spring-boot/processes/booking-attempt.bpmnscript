// Seat booking as a block of work that can be given up. `attempt BookAndPay`
// holds the seat, charges the travel card and issues the ticket; a guard on
// the declined charge ends that path with
// `end BookingAbandoned "Give up the booking" cancel`, and
// `on BookAndPay: cancel` catches it. Started with `chargeDeclined` set, the
// charge is declined and the escape task opens; started without it, the
// block completes and the booking goes to confirmation.
//
// Giving up the block undoes the steps inside it that had already finished
// and carry an `on compensation` block, and it undoes them before the cancel
// handler opens. `HoldSeat` has one, so the seat goes back on sale.
// `ChargeCard` has none, so it stays completed and nothing reverses it.
// Nothing outside the block is undone either.
//
// Every service task points at the generic delegate
// examples/spring-boot/src/main/java/com/example/demo/LogDelegate.java, so
// this process deploys and runs on the demo profile without additional Java
// classes.

process booking-attempt {
  var chargeDeclined: boolean

  start BookingRequested

  attempt BookAndPay "Try to book and pay for the seat" {
    subprocess HoldSeat "Hold the seat" {
      service HoldSeatTask "Take the seat off sale" { class = "com.example.demo.LogDelegate" }

      on compensation {
        service ReleaseSeat "Put the seat back on sale" { class = "com.example.demo.LogDelegate" }
      }
    }

    service ChargeCard "Charge the travel card" { class = "com.example.demo.LogDelegate" }

    if (chargeDeclined) {
      end BookingAbandoned "Give up the booking" cancel
    }

    service IssueTicket "Issue the ticket" { class = "com.example.demo.LogDelegate" }
  }

  user ConfirmBooking "Confirm the booking" { assignee = "demo" }
  end BookingComplete

  on BookAndPay: cancel {
    user ApologizeToTraveler "Apologize and confirm the seat was released" { assignee = "demo" }
    end BookingCancelled
  }
}

// A block of work that can be given up: started with `chargeDeclined` set,
// the cancel end inside the block fires and `on BookAndPay: cancel` catches it.
//
// Giving up the block undoes every finished step inside it that carries an
// `on compensation` block, before the cancel handler opens. `HoldSeat` has
// one, so the seat goes back on sale; `ChargeCard` has none, so it stays
// completed. Nothing outside the block is undone.

process booking-attempt {
  var chargeDeclined: boolean

  start BookingRequested

  attempt BookAndPay(label: "Try to book and pay for the seat") {
    subprocess HoldSeat(label: "Hold the seat") {
      service HoldSeatTask(label: "Take the seat off sale", class: "com.example.demo.LogDelegate")

      on compensation {
        service ReleaseSeat(label: "Put the seat back on sale", class: "com.example.demo.LogDelegate")
      }
    }

    service ChargeCard(label: "Charge the travel card", class: "com.example.demo.LogDelegate")

    if (chargeDeclined) {
      end BookingAbandoned cancel(label: "Give up the booking")
    }

    service IssueTicket(label: "Issue the ticket", class: "com.example.demo.LogDelegate")
  }

  user ConfirmBooking(label: "Confirm the booking", assignee: "demo")
  end BookingComplete

  on BookAndPay: cancel {
    user ApologizeToTraveler(label: "Apologize and confirm the seat was released", assignee: "demo")
    end BookingCancelled
  }
}

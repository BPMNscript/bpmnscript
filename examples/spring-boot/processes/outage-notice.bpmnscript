// Outage notice: one mail task the engine sends itself. The harness and the
// demo profile deploy this process and never start it, since sending needs an
// SMTP server neither runs. Deploying is the proof: the engine builds the mail
// behaviour at parse time and refuses a task missing a recipient or a body.

process outage-notice(label: "Outage notice") {
  start OutageDetected

  service NotifyOperators(label: "Notify the operators by mail", type: "mail") {
    field to = "ops@example.com"
    field subject = "Outage detected"
    field text = "An outage was detected; the incident channel has the details."
  }

  end OperatorsNotified
}

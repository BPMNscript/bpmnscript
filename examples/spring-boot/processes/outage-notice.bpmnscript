// Deployed and never started: sending needs an SMTP server the fixture does
// not run. Deploying alone proves the engine builds the mail behaviour at
// parse time, where it refuses a task missing a recipient or a body.

process outage-notice(label: "Outage notice") {
  start OutageDetected

  service NotifyOperators(label: "Notify the operators by mail", type: "mail") {
    field to = "ops@example.com"
    field subject = "Outage detected"
    field text = "An outage was detected; the incident channel has the details."
  }

  end OperatorsNotified
}

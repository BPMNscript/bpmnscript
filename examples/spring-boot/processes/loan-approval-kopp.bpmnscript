process loan-approval-kopp(label: "Loan Approval (Kopp 2009)") {
  var amount: number
  var creditScore: number
  var extRes1: string
  var extRes2: string
  var intRes: string
  var assessorRes: string

  start RequestReceived(label: "Loan request received") {
    form {
      amount: number "Loan amount"
      creditScore: number "Credit score"
    }
  }

  // Seeds `assessorRes = high`, so the assessment counts as high risk unless
  // the assessor lowers it.
  service InitRequest(label: "Initialize request", class: "com.example.loan.kopp.InitDelegate")

  parallel {
    {
      service CheckExternalS1(label: "Check external rating S1", class: "com.example.loan.kopp.ExternalRatingS1Delegate")
    }
    {
      service CheckExternalS2(label: "Check external rating S2", class: "com.example.loan.kopp.ExternalRatingS2Delegate")
    }
    {
      service CheckInternal(label: "Check internal rating", class: "com.example.loan.kopp.InternalRatingDelegate")
      if (intRes == "low") {
        user AssessRisk(label: "Manual risk assessment", assignee: "demo") {
          form {
            assessorRes: string "Assessor result (low/high)"
          }
        }
      }
    }
  }

  if ((extRes1 == "low" && extRes2 == "low") || (intRes == "low" && assessorRes == "low")) {
    service AcceptLoan(label: "Accept loan", class: "com.example.loan.kopp.AcceptLoanDelegate")
  } else {
    service RejectLoan(label: "Reject loan", class: "com.example.loan.kopp.RejectLoanDelegate")
  }

  end Done(label: "Loan request handled")
}

// `autoApproved` is set by the called process's auto-approve delegate. Deploy
// `invoice-approval` alongside, or the engine cannot resolve the call.

process purchasing {
  start OrderPlaced {
    form {
      amount: number "Order amount"
    }
  }

  call ReviewInvoice(label: "Review invoice approval", process: "invoice-approval") {
    in amount
    out autoApproved
  }

  end OrderReviewed
}

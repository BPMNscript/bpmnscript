// The link pair jumps from the throw to the catch with no flow drawn between
// them; the `goto` closes the loop by name.

process order-rework {
  var approved: boolean

  start Received
  user Review(assignee: "demo") {
    form { approved: boolean "Approved?" }
  }
  if (!approved) {
    emit link ToRework("Rework")
  }
  end Done
  await link AtRework("Rework")
  user Rework(assignee: "demo")
  goto Review
}

// The engine's form service refuses a submission that leaves the required
// enum empty or names a value outside its list.

process plan-selection {
  start SignedUp

  user ChoosePlan(label: "Choose a plan", assignee: "demo") {
    form {
      plan: enum "Plan" (required: true) {
        basic "Basic"
        plus "Plus"
      }
      notes: string "Notes for the account manager" (maxlength: 200)
    }
  }

  end PlanChosen
}

// Started with `failCharge` set, the charge delegate throws the declared
// error and the boundary handler opens the review task; started without it,
// the charge goes through.

process charge-with-recovery {
  error CHARGE_FAILED(message: "The payment charge could not be completed")

  start OrderReceived

  service ChargeCard(label: "Charge the customer's card", class: "com.example.demo.FailingChargeDelegate")
  service ConfirmCharge(label: "Confirm the charge", class: "com.example.demo.LogDelegate")

  end OrderCharged

  on ChargeCard: error(CHARGE_FAILED, code: c, message: m) {
    user ReviewFailedCharge(label: "Review the failed charge", assignee: "demo")
    end ChargeFailedHandled
  }
}

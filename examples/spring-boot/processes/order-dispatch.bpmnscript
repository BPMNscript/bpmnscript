// An inclusive fork and a race. The join waits for exactly the branches the
// conditions opened, and both branches carry a condition on purpose: an
// unconditioned branch of an inclusive fork is always taken, which would leave
// the `else` nothing to pick up. In the `await`, the first trigger to fire
// cancels the other, so only one of `Handover` and `ChaseCarrier` is ever
// offered.

process order-dispatch(label: "Order dispatch") {
  var amount: number

  start OrderReceived(label: "Order received") {
    form {
      amount: number "Order amount"
    }
  }

  parallel {
    if (amount > 10000) {
      user Audit(label: "Audit the large order", assignee: "manager")
    }
    if (amount > 0) {
      user Record(label: "Record the order", assignee: "demo")
    }
    else {
      user Triage(label: "Triage the order by hand", assignee: "demo")
    }
  }

  await {
    message("DispatchConfirmed") {
      user Handover(label: "Hand the shipment to the carrier", assignee: "demo")
    }
    timer("PT30M") {
      user ChaseCarrier(label: "Chase the carrier", assignee: "demo")
    }
  }

  user CloseOrder(label: "Close the order", assignee: "demo")

  end OrderDispatched(label: "Order dispatched")
}

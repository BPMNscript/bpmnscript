// The timer definition parks a job at deployment. The date is far enough out
// that the engine's own clock never reaches it, so the test fires the job by
// hand and the assertion never depends on wall time.

process scheduled-audit {
  start AuditWindowOpens "The audit window opens" timer at "2099-01-01T00:00:00"

  user ReviewAudit "Review the audit" { assignee = "demo" }

  end AuditFiled "Audit filed"
}

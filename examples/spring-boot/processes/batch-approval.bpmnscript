// Every repetition form in one process, each on a step whose runs are
// observable over the REST API.

process batch-approval(label: "Batch approval") {
  start BatchReceived

  user CollectApprovals for 3(label: "Approve the batch", assignee: "demo")

  user SignOff for 3 sequentially(label: "Sign the batch off", assignee: "demo")

  user SpotCheck for 3 sequentially until (nrOfCompletedInstances >= 2)(label: "Spot-check the entries", assignee: "demo")

  service LogEntry for 4(label: "Log the entry", class: "com.example.demo.LogDelegate")

  subprocess ReviewLines(label: "Review the lines") {
    input lines = ["ann", "bob", "cal"]
  } {
    user ReviewLine for each line in lines(label: "Review one line", assignee: "demo")
  }

  user CloseBatch(label: "Close the batch", assignee: "demo")

  end BatchClosed
}

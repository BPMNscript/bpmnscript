{
  "name": "bpmn-script-workspace",
  "description": "Write executable business processes as text, compile to BPMN 2.0 XML, and read existing BPMN files back as text.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BPMNscript/bpmnscript.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "watch": "tsc -b tsconfig.build.json --watch",
    "build": "npm run langium:generate && tsc -b tsconfig.build.json && npm run build:post --workspaces --if-present",
    "build:clean": "npm run clean && npm run build",
    "langium:generate": "npm run --workspace packages/language langium:generate",
    "langium:watch": "npm run --workspace packages/language langium:watch",
    "format": "prettier --write packages tests docs examples \"*.md\"",
    "format:check": "prettier --check packages tests docs examples \"*.md\"",
    "lint": "eslint packages tests",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0"
  },
  "workspaces": [
    "packages/language",
    "packages/cli",
    "packages/extension",
    "packages/transform",
    "tests"
  ]
}

// Repetition round-trip fixture: an order-fulfilment process whose stages each
// run once per item they are handed, so one program carries every form of the
// repeat clause:
//
//   - a bound collection on a user task;
//   - an expression collection on a service task, run sequentially and stopped
//     early by an until condition;
//   - a bare count on a service task;
//   - a count and a collection together on a step;
//   - an unbound collection on a receive;
//   - a bound collection on a call;
//   - a bound collection on a script task, the one head that carries the clause
//     before both its settings and a fenced body;
//   - a bound collection on a subprocess that also sets asyncBefore, which
//     applies to the repetition as a whole rather than to each run of it.
//
// Every collection variable is declared so the fixture opens validator-clean.

process order-fulfilment {
  var approvers: any
  var order: any
  var lines: any
  var batches: any
  var regions: any
  var parcels: any

  start OrderReceived

  user ApproveLines for each approver in approvers(label: "Approve the order lines", assignee: "demo")

  service ReserveStock for each line in "${order.lines}" sequentially until (nrOfCompletedInstances >= 2)(label: "Reserve the stock", class: "com.example.orders.ReserveStockDelegate")

  service WarmPricing for 3(label: "Warm the pricing cache", class: "com.example.orders.WarmPricingDelegate")

  step RecordLine for 2 each line in lines(label: "Record each line")

  receive AwaitBatch for each in batches(label: "Wait for each batch")

  call RegionalReport for each region in regions(label: "Run the regional report", process: "regional-report")

  script LabelParcel for each parcel in parcels(label: "Label each parcel", resultVariable: "parcelLabel") ```javascript
"LBL-" + loopCounter;
```

  subprocess DispatchParcels for each parcel in parcels sequentially(label: "Dispatch each parcel", asyncBefore: true) {
    service HandToCarrier(label: "Hand the parcel to the carrier", class: "com.example.orders.HandToCarrierDelegate")
  }

  end OrderFulfilled
}

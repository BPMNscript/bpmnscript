process claim-settlement(
  label: "Motor claim settlement",
  versionTag: "3.1.0",
  historyTimeToLive: "P90D",
  candidateStarterUsers: "demo,manager",
  candidateStarterGroups: "adjusters"
) {
  escalation PAYOUT_REVIEW

  start ClaimFiled(label: "Claim filed", initiator: "claimant", asyncAfter: true) {
    form {
      claimAmount: number "Claimed amount in euros"
      openQuestions: number "Questions still open with the claimant"
    }
  }

  user TriageClaim(
    label: "Triage the claim",
    assignee: "demo",
    formKey: "embedded:app:forms/claim-triage.html",
    candidateGroups: "adjusters",
    candidateUsers: "demo,manager",
    priority: 75,
    asyncBefore: true
  )

  while (openQuestions > 0) {
    user AskClaimant(label: "Ask the claimant for one missing detail", assignee: "demo")
  }

  subprocess InspectVehicle(label: "Inspect the vehicle", asyncBefore: true, exclusive: false) {
    start InspectionOrdered
    parallel {
      {
        service AssessBodywork(
          label: "Assess the bodywork",
          expression: "${bodyworkAssessor.assess(execution)}",
          resultVariable: "bodyworkReport",
          asyncBefore: true,
          retryCycle: "R3/PT5M"
        )
      }
      {
        script GradeMechanics(
          label: "Grade the mechanical damage",
          resultVariable: "mechanicsGrade",
          asyncBefore: true,
          jobPriority: 80
        ) ```groovy
def grade = claimAmount > 5000 ? "major" : "minor"
execution.setVariable("mechanicsGrade", grade)
```
      }
    }
    end InspectionReported
  }

  await message("RepairQuoteReceived", asyncBefore: true)

  call OrderRepair(
    label: "Order the repair",
    process: "repair-order",
    asyncAfter: true,
    retryCycle: "R5/PT10M"
  ) {
    in claimAmount
    out repairCost
  }

  if (claimAmount > 10000) {
    emit escalation PayoutReviewNeeded(PAYOUT_REVIEW, asyncAfter: true, jobPriority: 40)
  }

  user ApprovePayout(label: "Approve the payout", assignee: "manager", formRef: "payout-approval", version: 2)

  end ClaimSettled(label: "Claim settled", asyncBefore: true)

  on ApprovePayout: timer("PT8H", asyncAfter: true, exclusive: false, alongside) {
    service NudgeApprover(label: "Nudge the approver", class: "com.example.claims.NudgeDelegate")
  }

  on escalation(PAYOUT_REVIEW, asyncBefore: true, jobPriority: 60, retryCycle: "R2/PT30S", alongside) {
    start ReviewRequested
    user ReviewLargePayout(label: "Review the large payout", assignee: "manager")
    end ReviewRecorded
  }
}

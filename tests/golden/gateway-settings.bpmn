<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_loan-application" targetNamespace="http://bpmnscript.io/processes" exporter="BPMNscript" exporterVersion="0.0.0">
  <bpmn:process id="loan-application" name="Consumer loan application" isExecutable="true" operaton:historyTimeToLive="P30D">
    <bpmn:startEvent id="Applied" name="Application received">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="creditScore" label="Score reported by the credit bureau" type="long" />
          <operaton:formField id="amount" label="Requested amount in euros" type="long" />
          <operaton:formField id="documentsMissing" label="Whether a required document is still missing" type="boolean" />
          <operaton:formField id="referencesPending" label="Whether a reference has yet to reply" type="boolean" />
          <operaton:formField id="selfEmployed" label="Whether the applicant is self-employed" type="boolean" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Applied_ScreenApplication</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ScreenApplication" name="Screen the application for completeness" operaton:assignee="demo">
      <bpmn:incoming>Flow_Applied_ScreenApplication</bpmn:incoming>
      <bpmn:outgoing>Flow_ScreenApplication_Gateway_loan-application_2_split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_loan-application_2_split" default="Flow_Gateway_loan-application_2_split_default" operaton:asyncBefore="true" operaton:exclusive="false" operaton:jobPriority="30">
      <bpmn:incoming>Flow_ScreenApplication_Gateway_loan-application_2_split</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_2_split_PreApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_loan-application_2_split_ReviewScore</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_loan-application_2_split_default</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_loan-application_2_join" operaton:asyncBefore="true" operaton:jobPriority="20">
      <bpmn:incoming>Flow_PreApprove_Gateway_loan-application_2_join</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewScore_Gateway_loan-application_2_join</bpmn:incoming>
      <bpmn:incoming>Flow_FlagRisk_Gateway_loan-application_2_join</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_2_join_Gateway_loan-application_3_loop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PreApprove" name="Pre-approve on the bureau score alone" operaton:class="com.example.loans.PreApproveDelegate">
      <bpmn:incoming>Flow_Gateway_loan-application_2_split_PreApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_PreApprove_Gateway_loan-application_2_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ReviewScore" name="Review the borderline score by hand" operaton:assignee="demo">
      <bpmn:incoming>Flow_Gateway_loan-application_2_split_ReviewScore</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewScore_Gateway_loan-application_2_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="FlagRisk" name="Flag the application as high risk" operaton:class="com.example.loans.RiskFlagDelegate">
      <bpmn:incoming>Flow_Gateway_loan-application_2_split_default</bpmn:incoming>
      <bpmn:outgoing>Flow_FlagRisk_Gateway_loan-application_2_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_loan-application_3_loop" default="Flow_Gateway_loan-application_3_loop_default" operaton:asyncAfter="true">
      <bpmn:extensionElements>
        <operaton:failedJobRetryTimeCycle>R3/PT10M</operaton:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_loan-application_3_1_join_Gateway_loan-application_3_loop</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_loan-application_2_join_Gateway_loan-application_3_loop</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_3_loop_RequestDocument</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_loan-application_3_loop_default</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="RequestDocument" name="Ask the applicant for the missing document" operaton:assignee="demo">
      <bpmn:incoming>Flow_Gateway_loan-application_3_loop_RequestDocument</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestDocument_Gateway_loan-application_3_1_split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_loan-application_3_1_split" default="Flow_Gateway_loan-application_3_1_split_default">
      <bpmn:incoming>Flow_RequestDocument_Gateway_loan-application_3_1_split</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_3_1_split_RequestAccounts</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_loan-application_3_1_split_default</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_loan-application_3_1_join">
      <bpmn:incoming>Flow_RequestAccounts_Gateway_loan-application_3_1_join</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_loan-application_3_1_split_default</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_3_1_join_Gateway_loan-application_3_loop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="RequestAccounts" name="Ask for the latest business accounts too" operaton:assignee="demo">
      <bpmn:incoming>Flow_Gateway_loan-application_3_1_split_RequestAccounts</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestAccounts_Gateway_loan-application_3_1_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="CollectReferences" name="Collect the references the applicant named">
      <bpmn:incoming>Flow_Gateway_loan-application_3_loop_default</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectReferences_Gateway_loan-application_5_fork</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_CollectReferences">
        <bpmn:outgoing>Flow_StartEvent_CollectReferences_ChaseReference</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="ChaseReference" name="Chase one outstanding reference" operaton:assignee="demo">
        <bpmn:incoming>Flow_Gateway_loan-application_4_0_loop_ChaseReference</bpmn:incoming>
        <bpmn:incoming>Flow_StartEvent_CollectReferences_ChaseReference</bpmn:incoming>
        <bpmn:outgoing>Flow_ChaseReference_Gateway_loan-application_4_0_loop</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_loan-application_4_0_loop" default="Flow_Gateway_loan-application_4_0_loop_default" operaton:exclusive="false" operaton:jobPriority="10">
        <bpmn:incoming>Flow_ChaseReference_Gateway_loan-application_4_0_loop</bpmn:incoming>
        <bpmn:outgoing>Flow_Gateway_loan-application_4_0_loop_ChaseReference</bpmn:outgoing>
        <bpmn:outgoing>Flow_Gateway_loan-application_4_0_loop_default</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_CollectReferences">
        <bpmn:incoming>Flow_Gateway_loan-application_4_0_loop_default</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ChaseReference_Gateway_loan-application_4_0_loop" sourceRef="ChaseReference" targetRef="Gateway_loan-application_4_0_loop" />
      <bpmn:sequenceFlow id="Flow_Gateway_loan-application_4_0_loop_ChaseReference" name="referencesPending" sourceRef="Gateway_loan-application_4_0_loop" targetRef="ChaseReference">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${referencesPending}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_StartEvent_CollectReferences_ChaseReference" sourceRef="StartEvent_CollectReferences" targetRef="ChaseReference" />
      <bpmn:sequenceFlow id="Flow_Gateway_loan-application_4_0_loop_default" sourceRef="Gateway_loan-application_4_0_loop" targetRef="EndEvent_CollectReferences" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="Gateway_loan-application_5_fork" operaton:asyncBefore="true">
      <bpmn:incoming>Flow_CollectReferences_Gateway_loan-application_5_fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_5_fork_VerifyIdentity</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_loan-application_5_fork_ScreenFraud</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_loan-application_5_join" operaton:asyncAfter="true" operaton:exclusive="false">
      <bpmn:extensionElements>
        <operaton:failedJobRetryTimeCycle>R2/PT1M</operaton:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_VerifyIdentity_Gateway_loan-application_5_join</bpmn:incoming>
      <bpmn:incoming>Flow_ScreenFraud_Gateway_loan-application_5_join</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_5_join_Gateway_loan-application_6_fork</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="VerifyIdentity" name="Verify the applicant against the register" operaton:class="com.example.loans.IdentityDelegate">
      <bpmn:incoming>Flow_Gateway_loan-application_5_fork_VerifyIdentity</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyIdentity_Gateway_loan-application_5_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ScreenFraud" name="Run the fraud screen" operaton:class="com.example.loans.FraudDelegate">
      <bpmn:incoming>Flow_Gateway_loan-application_5_fork_ScreenFraud</bpmn:incoming>
      <bpmn:outgoing>Flow_ScreenFraud_Gateway_loan-application_5_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="Gateway_loan-application_6_fork" default="Flow_Gateway_loan-application_6_fork_default" operaton:jobPriority="${selfEmployed ? 90 : 50}">
      <bpmn:incoming>Flow_Gateway_loan-application_5_join_Gateway_loan-application_6_fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_6_fork_AppraiseCollateral</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_loan-application_6_fork_PriceLoan</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_loan-application_6_fork_default</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:inclusiveGateway id="Gateway_loan-application_6_join" operaton:asyncBefore="true">
      <bpmn:incoming>Flow_AppraiseCollateral_Gateway_loan-application_6_join</bpmn:incoming>
      <bpmn:incoming>Flow_PriceLoan_Gateway_loan-application_6_join</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_loan-application_6_fork_default</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_6_join_MakeOffer</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="AppraiseCollateral" name="Appraise the offered collateral" operaton:assignee="manager">
      <bpmn:incoming>Flow_Gateway_loan-application_6_fork_AppraiseCollateral</bpmn:incoming>
      <bpmn:outgoing>Flow_AppraiseCollateral_Gateway_loan-application_6_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PriceLoan" name="Price the loan from the checks" operaton:class="com.example.loans.PricingDelegate">
      <bpmn:incoming>Flow_Gateway_loan-application_6_fork_PriceLoan</bpmn:incoming>
      <bpmn:outgoing>Flow_PriceLoan_Gateway_loan-application_6_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="MakeOffer" name="Send the offer to the applicant" operaton:assignee="demo">
      <bpmn:incoming>Flow_Gateway_loan-application_6_join_MakeOffer</bpmn:incoming>
      <bpmn:outgoing>Flow_MakeOffer_Gateway_loan-application_8_race</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="Gateway_loan-application_8_race" operaton:asyncBefore="true" operaton:jobPriority="5">
      <bpmn:incoming>Flow_MakeOffer_Gateway_loan-application_8_race</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_8_race_Catch_loan-application_8_b0</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_loan-application_8_race_Catch_loan-application_8_b1</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:exclusiveGateway id="Gateway_loan-application_8_join" operaton:asyncBefore="true">
      <bpmn:incoming>Flow_DisburseFunds_Gateway_loan-application_8_join</bpmn:incoming>
      <bpmn:incoming>Flow_ExpireOffer_Gateway_loan-application_8_join</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_loan-application_8_join_Closed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_loan-application_8_b0">
      <bpmn:incoming>Flow_Gateway_loan-application_8_race_Catch_loan-application_8_b0</bpmn:incoming>
      <bpmn:outgoing>Flow_Catch_loan-application_8_b0_DisburseFunds</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_OfferAccepted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="DisburseFunds" name="Pay the loan out" operaton:class="com.example.loans.DisburseDelegate">
      <bpmn:incoming>Flow_Catch_loan-application_8_b0_DisburseFunds</bpmn:incoming>
      <bpmn:outgoing>Flow_DisburseFunds_Gateway_loan-application_8_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Catch_loan-application_8_b1">
      <bpmn:incoming>Flow_Gateway_loan-application_8_race_Catch_loan-application_8_b1</bpmn:incoming>
      <bpmn:outgoing>Flow_Catch_loan-application_8_b1_ExpireOffer</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ExpireOffer" name="Withdraw the unanswered offer" operaton:class="com.example.loans.ExpireDelegate">
      <bpmn:incoming>Flow_Catch_loan-application_8_b1_ExpireOffer</bpmn:incoming>
      <bpmn:outgoing>Flow_ExpireOffer_Gateway_loan-application_8_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Closed" name="Application closed">
      <bpmn:incoming>Flow_Gateway_loan-application_8_join_Closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Applied_ScreenApplication" sourceRef="Applied" targetRef="ScreenApplication" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_2_split_PreApprove" name="creditScore &#62;= 700" sourceRef="Gateway_loan-application_2_split" targetRef="PreApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditScore &gt;= 700}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PreApprove_Gateway_loan-application_2_join" sourceRef="PreApprove" targetRef="Gateway_loan-application_2_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_2_split_ReviewScore" name="creditScore &#62;= 600" sourceRef="Gateway_loan-application_2_split" targetRef="ReviewScore">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditScore &gt;= 600}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewScore_Gateway_loan-application_2_join" sourceRef="ReviewScore" targetRef="Gateway_loan-application_2_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_2_split_default" sourceRef="Gateway_loan-application_2_split" targetRef="FlagRisk" />
    <bpmn:sequenceFlow id="Flow_FlagRisk_Gateway_loan-application_2_join" sourceRef="FlagRisk" targetRef="Gateway_loan-application_2_join" />
    <bpmn:sequenceFlow id="Flow_ScreenApplication_Gateway_loan-application_2_split" sourceRef="ScreenApplication" targetRef="Gateway_loan-application_2_split" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_3_1_split_RequestAccounts" name="selfEmployed" sourceRef="Gateway_loan-application_3_1_split" targetRef="RequestAccounts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${selfEmployed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RequestAccounts_Gateway_loan-application_3_1_join" sourceRef="RequestAccounts" targetRef="Gateway_loan-application_3_1_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_3_1_split_default" sourceRef="Gateway_loan-application_3_1_split" targetRef="Gateway_loan-application_3_1_join" />
    <bpmn:sequenceFlow id="Flow_RequestDocument_Gateway_loan-application_3_1_split" sourceRef="RequestDocument" targetRef="Gateway_loan-application_3_1_split" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_3_loop_RequestDocument" name="documentsMissing" sourceRef="Gateway_loan-application_3_loop" targetRef="RequestDocument">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentsMissing}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_3_1_join_Gateway_loan-application_3_loop" sourceRef="Gateway_loan-application_3_1_join" targetRef="Gateway_loan-application_3_loop" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_2_join_Gateway_loan-application_3_loop" sourceRef="Gateway_loan-application_2_join" targetRef="Gateway_loan-application_3_loop" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_3_loop_default" sourceRef="Gateway_loan-application_3_loop" targetRef="CollectReferences" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_5_fork_VerifyIdentity" sourceRef="Gateway_loan-application_5_fork" targetRef="VerifyIdentity" />
    <bpmn:sequenceFlow id="Flow_VerifyIdentity_Gateway_loan-application_5_join" sourceRef="VerifyIdentity" targetRef="Gateway_loan-application_5_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_5_fork_ScreenFraud" sourceRef="Gateway_loan-application_5_fork" targetRef="ScreenFraud" />
    <bpmn:sequenceFlow id="Flow_ScreenFraud_Gateway_loan-application_5_join" sourceRef="ScreenFraud" targetRef="Gateway_loan-application_5_join" />
    <bpmn:sequenceFlow id="Flow_CollectReferences_Gateway_loan-application_5_fork" sourceRef="CollectReferences" targetRef="Gateway_loan-application_5_fork" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_6_fork_AppraiseCollateral" name="amount &#62; 250000" sourceRef="Gateway_loan-application_6_fork" targetRef="AppraiseCollateral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 250000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AppraiseCollateral_Gateway_loan-application_6_join" sourceRef="AppraiseCollateral" targetRef="Gateway_loan-application_6_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_6_fork_PriceLoan" sourceRef="Gateway_loan-application_6_fork" targetRef="PriceLoan" />
    <bpmn:sequenceFlow id="Flow_PriceLoan_Gateway_loan-application_6_join" sourceRef="PriceLoan" targetRef="Gateway_loan-application_6_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_6_fork_default" sourceRef="Gateway_loan-application_6_fork" targetRef="Gateway_loan-application_6_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_5_join_Gateway_loan-application_6_fork" sourceRef="Gateway_loan-application_5_join" targetRef="Gateway_loan-application_6_fork" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_6_join_MakeOffer" sourceRef="Gateway_loan-application_6_join" targetRef="MakeOffer" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_8_race_Catch_loan-application_8_b0" sourceRef="Gateway_loan-application_8_race" targetRef="Catch_loan-application_8_b0" />
    <bpmn:sequenceFlow id="Flow_Catch_loan-application_8_b0_DisburseFunds" sourceRef="Catch_loan-application_8_b0" targetRef="DisburseFunds" />
    <bpmn:sequenceFlow id="Flow_DisburseFunds_Gateway_loan-application_8_join" sourceRef="DisburseFunds" targetRef="Gateway_loan-application_8_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_8_race_Catch_loan-application_8_b1" sourceRef="Gateway_loan-application_8_race" targetRef="Catch_loan-application_8_b1" />
    <bpmn:sequenceFlow id="Flow_Catch_loan-application_8_b1_ExpireOffer" sourceRef="Catch_loan-application_8_b1" targetRef="ExpireOffer" />
    <bpmn:sequenceFlow id="Flow_ExpireOffer_Gateway_loan-application_8_join" sourceRef="ExpireOffer" targetRef="Gateway_loan-application_8_join" />
    <bpmn:sequenceFlow id="Flow_MakeOffer_Gateway_loan-application_8_race" sourceRef="MakeOffer" targetRef="Gateway_loan-application_8_race" />
    <bpmn:sequenceFlow id="Flow_Gateway_loan-application_8_join_Closed" sourceRef="Gateway_loan-application_8_join" targetRef="Closed" />
  </bpmn:process>
  <bpmn:message id="Message_OfferAccepted" name="OfferAccepted" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_loan-application">
    <bpmndi:BPMNPlane id="BPMNPlane_loan-application" bpmnElement="loan-application">
      <bpmndi:BPMNShape id="Applied_di" bpmnElement="Applied">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScreenApplication_di" bpmnElement="ScreenApplication">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_loan-application_2_split_di" bpmnElement="Gateway_loan-application_2_split" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PreApprove_di" bpmnElement="PreApprove">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_loan-application_2_join_di" bpmnElement="Gateway_loan-application_2_join" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_loan-application_3_loop_di" bpmnElement="Gateway_loan-application_3_loop" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RequestDocument_di" bpmnElement="RequestDocument">

      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RecordProviderOutage_BookingHalted_di" bpmnElement="Flow_RecordProviderOutage_BookingHalted">
        <di:waypoint x="2675" y="770" />
        <di:waypoint x="3657" y="770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApologizeToTraveler_BookingCancelled_di" bpmnElement="Flow_ApologizeToTraveler_BookingCancelled">
        <di:waypoint x="2675" y="910" />
        <di:waypoint x="3657" y="910" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="DepartureOpened_di" bpmnElement="DepartureOpened">
        <dc:Bounds x="2682" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AssignSeatRows_di" bpmnElement="AssignSeatRows" isExpanded="true">
        <dc:Bounds x="2800" y="100" width="550" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DeparturePrepared_di" bpmnElement="DeparturePrepared">
        <dc:Bounds x="3432" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_DepartureOpened_AssignSeatRows_di" bpmnElement="Flow_DepartureOpened_AssignSeatRows">
        <di:waypoint x="2718" y="140" />
        <di:waypoint x="2800" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AssignSeatRows_DeparturePrepared_di" bpmnElement="Flow_AssignSeatRows_DeparturePrepared">
        <di:waypoint x="3350" y="140" />
        <di:waypoint x="3432" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BookingOpened_di" bpmnElement="BookingOpened">
        <dc:Bounds x="432" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HoldSeats_di" bpmnElement="HoldSeats" isExpanded="true">
        <dc:Bounds x="550" y="100" width="1000" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ChargeCard_di" bpmnElement="ChargeCard">
        <dc:Bounds x="1600" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_seat-booking_2_3_split_di" bpmnElement="Gateway_seat-booking_2_3_split" isMarkerVisible="true">
        <dc:Bounds x="1775" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookingAbandoned_di" bpmnElement="BookingAbandoned">
        <dc:Bounds x="1932" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_seat-booking_2_3_join_di" bpmnElement="Gateway_seat-booking_2_3_join" isMarkerVisible="true">
        <dc:Bounds x="2075" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IssueTickets_di" bpmnElement="IssueTickets">
        <dc:Bounds x="2200" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookingSecured_di" bpmnElement="BookingSecured">
        <dc:Bounds x="2382" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_BookingOpened_HoldSeats_di" bpmnElement="Flow_BookingOpened_HoldSeats">
        <di:waypoint x="468" y="140" />
        <di:waypoint x="550" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HoldSeats_ChargeCard_di" bpmnElement="Flow_HoldSeats_ChargeCard">
        <di:waypoint x="1550" y="140" />
        <di:waypoint x="1600" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ChargeCard_Gateway_seat-booking_2_3_split_di" bpmnElement="Flow_ChargeCard_Gateway_seat-booking_2_3_split">
        <di:waypoint x="1700" y="140" />
        <di:waypoint x="1775" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_seat-booking_2_3_split_BookingAbandoned_di" bpmnElement="Flow_Gateway_seat-booking_2_3_split_BookingAbandoned">
        <di:waypoint x="1825" y="140" />
        <di:waypoint x="1932" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_seat-booking_2_3_split_default_di" bpmnElement="Flow_Gateway_seat-booking_2_3_split_default">
        <di:waypoint x="1800" y="165" />
        <di:waypoint x="1800" y="140" />
        <di:waypoint x="2100" y="140" />
        <di:waypoint x="2100" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_seat-booking_2_3_join_IssueTickets_di" bpmnElement="Flow_Gateway_seat-booking_2_3_join_IssueTickets">
        <di:waypoint x="2125" y="140" />
        <di:waypoint x="2200" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IssueTickets_BookingSecured_di" bpmnElement="Flow_IssueTickets_BookingSecured">
        <di:waypoint x="2300" y="140" />
        <di:waypoint x="2382" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="StartEvent_AssignSeatRows_di" bpmnElement="StartEvent_AssignSeatRows">
        <dc:Bounds x="2907" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AssignRow_di" bpmnElement="AssignRow">
        <dc:Bounds x="3025" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>

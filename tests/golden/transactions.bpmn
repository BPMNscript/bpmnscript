        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookAndPay_di" bpmnElement="BookAndPay" isExpanded="true">
        <dc:Bounds x="325" y="30" width="2200" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_BookAndPay_cancel_di" bpmnElement="Boundary_BookAndPay_cancel">
        <dc:Bounds x="1040.3333333333335" y="652" width="36" height="36" />
      </bpmndi:BPMNShape>

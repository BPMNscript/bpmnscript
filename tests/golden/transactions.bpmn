        <dc:Bounds x="2575" y="730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookingHalted_di" bpmnElement="BookingHalted">
        <dc:Bounds x="3657" y="752" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApologizeToTraveler_di" bpmnElement="ApologizeToTraveler">
        <dc:Bounds x="2575" y="870" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookingCancelled_di" bpmnElement="BookingCancelled">
        <dc:Bounds x="3657" y="892" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_BookingRequested_ReviewRequest_di" bpmnElement="Flow_BookingRequested_ReviewRequest">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReviewRequest_BookAndPay_di" bpmnElement="Flow_ReviewRequest_BookAndPay">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BookAndPay_PrepareDeparture_di" bpmnElement="Flow_BookAndPay_PrepareDeparture">
        <di:waypoint x="2525" y="70" />
        <di:waypoint x="2575" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Boundary_BookAndPay_cancel_ApologizeToTraveler_di" bpmnElement="Flow_Boundary_BookAndPay_cancel_ApologizeToTraveler">
        <di:waypoint x="1058.3333333333335" y="688" />
        <di:waypoint x="1058.3333333333335" y="910" />
        <di:waypoint x="2575" y="910" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Boundary_BookAndPay_error_RecordProviderOutage_di" bpmnElement="Flow_Boundary_BookAndPay_error_RecordProviderOutage">
        <di:waypoint x="1791.6666666666667" y="688" />
        <di:waypoint x="1791.6666666666667" y="770" />
        <di:waypoint x="2575" y="770" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PrepareDeparture_ConfirmBooking_di" bpmnElement="Flow_PrepareDeparture_ConfirmBooking">
        <di:waypoint x="3575" y="70" />
        <di:waypoint x="3625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ConfirmBooking_BookingComplete_di" bpmnElement="Flow_ConfirmBooking_BookingComplete">
        <di:waypoint x="3725" y="70" />

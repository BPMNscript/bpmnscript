<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_seat-booking" targetNamespace="http://bpmnscript.io/processes" exporter="BPMNscript" exporterVersion="0.0.0">
  <bpmn:process id="seat-booking" name="Seat Booking" isExecutable="true" operaton:historyTimeToLive="P30D">
    <bpmn:startEvent id="BookingRequested">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="chargeDeclined" label="Whether the card issuer declined the charge" type="boolean" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_BookingRequested_ReviewRequest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ReviewRequest" name="Review the seat request" operaton:assignee="demo">
      <bpmn:incoming>Flow_BookingRequested_ReviewRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewRequest_BookAndPay</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:transaction id="BookAndPay" name="Try to book and pay for the seats">
      <bpmn:incoming>Flow_ReviewRequest_BookAndPay</bpmn:incoming>
      <bpmn:outgoing>Flow_BookAndPay_PrepareDeparture</bpmn:outgoing>
      <bpmn:startEvent id="BookingOpened">
        <bpmn:outgoing>Flow_BookingOpened_HoldSeats</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:subProcess id="HoldSeats" name="Hold the seats">
        <bpmn:incoming>Flow_BookingOpened_HoldSeats</bpmn:incoming>
        <bpmn:outgoing>Flow_HoldSeats_ChargeCard</bpmn:outgoing>
        <bpmn:startEvent id="HoldOpened">
          <bpmn:outgoing>Flow_HoldOpened_ReserveSeats</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="ReserveSeats" name="Take the seats off sale" operaton:class="com.example.booking.ReserveSeatsDelegate">
          <bpmn:incoming>Flow_HoldOpened_ReserveSeats</bpmn:incoming>
          <bpmn:outgoing>Flow_ReserveSeats_SeatsHeld</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="SeatsHeld">
          <bpmn:incoming>Flow_ReserveSeats_SeatsHeld</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:subProcess id="EventSubProcess_seat-booking_2_1_3" triggeredByEvent="true">
          <bpmn:startEvent id="ReleaseOpened">
            <bpmn:outgoing>Flow_ReleaseOpened_ReleaseSeats</bpmn:outgoing>
            <bpmn:compensateEventDefinition />
          </bpmn:startEvent>
          <bpmn:serviceTask id="ReleaseSeats" name="Put the seats back on sale" operaton:class="com.example.booking.ReleaseSeatsDelegate">
            <bpmn:incoming>Flow_ReleaseOpened_ReleaseSeats</bpmn:incoming>
            <bpmn:outgoing>Flow_ReleaseSeats_SeatsReleased</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:endEvent id="SeatsReleased">
            <bpmn:incoming>Flow_ReleaseSeats_SeatsReleased</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="Flow_ReleaseOpened_ReleaseSeats" sourceRef="ReleaseOpened" targetRef="ReleaseSeats" />
          <bpmn:sequenceFlow id="Flow_ReleaseSeats_SeatsReleased" sourceRef="ReleaseSeats" targetRef="SeatsReleased" />
        </bpmn:subProcess>
        <bpmn:sequenceFlow id="Flow_HoldOpened_ReserveSeats" sourceRef="HoldOpened" targetRef="ReserveSeats" />
        <bpmn:sequenceFlow id="Flow_ReserveSeats_SeatsHeld" sourceRef="ReserveSeats" targetRef="SeatsHeld" />
      </bpmn:subProcess>
      <bpmn:serviceTask id="ChargeCard" name="Charge the travel card" operaton:class="com.example.booking.ChargeCardDelegate">
        <bpmn:incoming>Flow_HoldSeats_ChargeCard</bpmn:incoming>
        <bpmn:outgoing>Flow_ChargeCard_Gateway_seat-booking_2_3_split</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_seat-booking_2_3_split" default="Flow_Gateway_seat-booking_2_3_split_default">
        <bpmn:incoming>Flow_ChargeCard_Gateway_seat-booking_2_3_split</bpmn:incoming>
        <bpmn:outgoing>Flow_Gateway_seat-booking_2_3_split_BookingAbandoned</bpmn:outgoing>
        <bpmn:outgoing>Flow_Gateway_seat-booking_2_3_split_default</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_seat-booking_2_3_join">
        <bpmn:incoming>Flow_Gateway_seat-booking_2_3_split_default</bpmn:incoming>
        <bpmn:outgoing>Flow_Gateway_seat-booking_2_3_join_IssueTickets</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="BookingAbandoned" name="Give up the booking">
        <bpmn:incoming>Flow_Gateway_seat-booking_2_3_split_BookingAbandoned</bpmn:incoming>
        <bpmn:cancelEventDefinition />
      </bpmn:endEvent>
      <bpmn:serviceTask id="IssueTickets" name="Issue the boarding tickets" operaton:class="com.example.booking.IssueTicketsDelegate">
        <bpmn:incoming>Flow_Gateway_seat-booking_2_3_join_IssueTickets</bpmn:incoming>
        <bpmn:outgoing>Flow_IssueTickets_BookingSecured</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="BookingSecured">
        <bpmn:incoming>Flow_IssueTickets_BookingSecured</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_BookingOpened_HoldSeats" sourceRef="BookingOpened" targetRef="HoldSeats" />
      <bpmn:sequenceFlow id="Flow_HoldSeats_ChargeCard" sourceRef="HoldSeats" targetRef="ChargeCard" />
      <bpmn:sequenceFlow id="Flow_Gateway_seat-booking_2_3_split_BookingAbandoned" name="chargeDeclined" sourceRef="Gateway_seat-booking_2_3_split" targetRef="BookingAbandoned">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${chargeDeclined}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Gateway_seat-booking_2_3_split_default" sourceRef="Gateway_seat-booking_2_3_split" targetRef="Gateway_seat-booking_2_3_join" />
      <bpmn:sequenceFlow id="Flow_ChargeCard_Gateway_seat-booking_2_3_split" sourceRef="ChargeCard" targetRef="Gateway_seat-booking_2_3_split" />
      <bpmn:sequenceFlow id="Flow_Gateway_seat-booking_2_3_join_IssueTickets" sourceRef="Gateway_seat-booking_2_3_join" targetRef="IssueTickets" />
      <bpmn:sequenceFlow id="Flow_IssueTickets_BookingSecured" sourceRef="IssueTickets" targetRef="BookingSecured" />
    </bpmn:transaction>
    <bpmn:subProcess id="PrepareDeparture" name="Prepare the departure list">
      <bpmn:incoming>Flow_BookAndPay_PrepareDeparture</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareDeparture_ConfirmBooking</bpmn:outgoing>
      <bpmn:startEvent id="DepartureOpened">
        <bpmn:outgoing>Flow_DepartureOpened_AssignSeatRows</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:transaction id="AssignSeatRows" name="Spread the party across rows" operaton:asyncBefore="true">
        <bpmn:incoming>Flow_DepartureOpened_AssignSeatRows</bpmn:incoming>
        <bpmn:outgoing>Flow_AssignSeatRows_DeparturePrepared</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" operaton:collection="seatRows" operaton:elementVariable="row" />
        <bpmn:startEvent id="StartEvent_AssignSeatRows">
          <bpmn:outgoing>Flow_StartEvent_AssignSeatRows_AssignRow</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="AssignRow" name="Assign one row of seats" operaton:class="com.example.booking.AssignRowDelegate">
          <bpmn:incoming>Flow_StartEvent_AssignSeatRows_AssignRow</bpmn:incoming>
          <bpmn:outgoing>Flow_AssignRow_EndEvent_AssignSeatRows</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="EndEvent_AssignSeatRows">
          <bpmn:incoming>Flow_AssignRow_EndEvent_AssignSeatRows</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_StartEvent_AssignSeatRows_AssignRow" sourceRef="StartEvent_AssignSeatRows" targetRef="AssignRow" />
        <bpmn:sequenceFlow id="Flow_AssignRow_EndEvent_AssignSeatRows" sourceRef="AssignRow" targetRef="EndEvent_AssignSeatRows" />
      </bpmn:transaction>
      <bpmn:endEvent id="DeparturePrepared">
        <bpmn:incoming>Flow_AssignSeatRows_DeparturePrepared</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_DepartureOpened_AssignSeatRows" sourceRef="DepartureOpened" targetRef="AssignSeatRows" />
      <bpmn:sequenceFlow id="Flow_AssignSeatRows_DeparturePrepared" sourceRef="AssignSeatRows" targetRef="DeparturePrepared" />
    </bpmn:subProcess>
    <bpmn:userTask id="ConfirmBooking" name="Confirm the seats with the traveler" operaton:assignee="demo">
      <bpmn:incoming>Flow_PrepareDeparture_ConfirmBooking</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmBooking_BookingComplete</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="BookingComplete">
      <bpmn:incoming>Flow_ConfirmBooking_BookingComplete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_BookAndPay_cancel" attachedToRef="BookAndPay">
      <bpmn:outgoing>Flow_Boundary_BookAndPay_cancel_ApologizeToTraveler</bpmn:outgoing>
      <bpmn:cancelEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="ApologizeToTraveler" name="Apologize and confirm the seats were released" operaton:assignee="demo">
      <bpmn:incoming>Flow_Boundary_BookAndPay_cancel_ApologizeToTraveler</bpmn:incoming>
      <bpmn:outgoing>Flow_ApologizeToTraveler_BookingCancelled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="BookingCancelled">
      <bpmn:incoming>Flow_ApologizeToTraveler_BookingCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_BookAndPay_error" attachedToRef="BookAndPay">
      <bpmn:outgoing>Flow_Boundary_BookAndPay_error_RecordProviderOutage</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_PAYMENT_UNAVAILABLE" operaton:errorCodeVariable="c" operaton:errorMessageVariable="m" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="RecordProviderOutage" name="Record the payment outage" operaton:class="com.example.booking.RecordOutageDelegate">
      <bpmn:incoming>Flow_Boundary_BookAndPay_error_RecordProviderOutage</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordProviderOutage_BookingHalted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BookingHalted">
      <bpmn:incoming>Flow_RecordProviderOutage_BookingHalted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_BookingRequested_ReviewRequest" sourceRef="BookingRequested" targetRef="ReviewRequest" />
    <bpmn:sequenceFlow id="Flow_ReviewRequest_BookAndPay" sourceRef="ReviewRequest" targetRef="BookAndPay" />
    <bpmn:sequenceFlow id="Flow_BookAndPay_PrepareDeparture" sourceRef="BookAndPay" targetRef="PrepareDeparture" />
    <bpmn:sequenceFlow id="Flow_PrepareDeparture_ConfirmBooking" sourceRef="PrepareDeparture" targetRef="ConfirmBooking" />
    <bpmn:sequenceFlow id="Flow_ConfirmBooking_BookingComplete" sourceRef="ConfirmBooking" targetRef="BookingComplete" />
    <bpmn:sequenceFlow id="Flow_ApologizeToTraveler_BookingCancelled" sourceRef="ApologizeToTraveler" targetRef="BookingCancelled" />
    <bpmn:sequenceFlow id="Flow_Boundary_BookAndPay_cancel_ApologizeToTraveler" sourceRef="Boundary_BookAndPay_cancel" targetRef="ApologizeToTraveler" />
    <bpmn:sequenceFlow id="Flow_RecordProviderOutage_BookingHalted" sourceRef="RecordProviderOutage" targetRef="BookingHalted" />
    <bpmn:sequenceFlow id="Flow_Boundary_BookAndPay_error_RecordProviderOutage" sourceRef="Boundary_BookAndPay_error" targetRef="RecordProviderOutage" />
  </bpmn:process>
  <bpmn:error id="Error_PAYMENT_UNAVAILABLE" name="PAYMENT_UNAVAILABLE" errorCode="PAYMENT_UNAVAILABLE" operaton:errorMessage="The payment provider could not be reached" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_seat-booking">
    <bpmndi:BPMNPlane id="BPMNPlane_seat-booking" bpmnElement="seat-booking">
      <bpmndi:BPMNShape id="BookingRequested_di" bpmnElement="BookingRequested">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>

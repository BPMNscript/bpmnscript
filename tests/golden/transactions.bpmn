        <dc:Bounds x="1773.6666666666667" y="652" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrepareDeparture_di" bpmnElement="PrepareDeparture" isExpanded="true">
        <dc:Bounds x="2575" y="30" width="1000" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ConfirmBooking_di" bpmnElement="ConfirmBooking">
        <dc:Bounds x="3625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>

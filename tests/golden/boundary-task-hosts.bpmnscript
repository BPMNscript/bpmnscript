// Boundary-event round-trip fixture: one checkout narrative that attaches a
// boundary handler to a script task and to a service task bound through its
// `topic` attribute — the delegated-to-an-external-worker form, the one
// binding this suite's other goldens leave uncovered.
//
// A card charge, a shipping-cost calculation, and a label print each run as
// their own step, one after another:
//
//   - charging the card can be declined by the gateway, so an interrupting
//     error boundary takes over and routes to a manual review;
//   - the shipping calculation can run long, so a one-hour timer nudges the
//     delay desk `alongside` a calculation that keeps running;
//   - printing the label can be pre-empted by an expedite request from the
//     warehouse, so an interrupting message boundary reroutes to an
//     expedited shipment.
//
// Each escape chain ends on its own (an implicit end), and every label
// differs from the name humanised from its id.

process boundary-task-hosts {
  error "PAYMENT_DECLINED" message "The payment gateway declined the charge"

  start OrderReceived

  service ChargeCard "Charge the card" { class = "com.example.checkout.ChargeDelegate" }

  script ComputeShipping "Compute the shipping cost" ```groovy
def shippingCost = weight * 2.5
execution.setVariable("shippingCost", shippingCost)
```

  service PrintLabel "Print the shipping label" { topic = "print-label" }

  end OrderShipped

  on ChargeCard: error "PAYMENT_DECLINED" {
    user ReviewPayment "Review the declined payment" { assignee = "demo" }
  }

  on ComputeShipping: timer after "PT1H" alongside {
    service NotifyShippingDelay "Notify the shipping delay desk" { class = "com.example.checkout.DelayDelegate" }
  }

  on PrintLabel: message "ExpediteRequested" {
    service ExpediteShipment "Expedite the shipment" { class = "com.example.checkout.ExpediteDelegate" }
  }
}

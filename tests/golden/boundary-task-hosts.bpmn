<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_boundary-task-hosts" targetNamespace="http://bpmnscript.io/processes" exporter="BPMNscript" exporterVersion="0.0.0">
  <bpmn:process id="boundary-task-hosts" name="Boundary Task Hosts" isExecutable="true" operaton:historyTimeToLive="P30D">
    <bpmn:startEvent id="OrderReceived">
      <bpmn:outgoing>Flow_OrderReceived_ChargeCard</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ChargeCard" name="Charge the card" operaton:class="com.example.checkout.ChargeDelegate">
      <bpmn:incoming>Flow_OrderReceived_ChargeCard</bpmn:incoming>
      <bpmn:outgoing>Flow_ChargeCard_ComputeShipping</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ComputeShipping" name="Compute the shipping cost" scriptFormat="groovy">
      <bpmn:incoming>Flow_ChargeCard_ComputeShipping</bpmn:incoming>
      <bpmn:outgoing>Flow_ComputeShipping_PrintLabel</bpmn:outgoing>
      <bpmn:script>def shippingCost = weight * 2.5
execution.setVariable("shippingCost", shippingCost)
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="PrintLabel" name="Print the shipping label" operaton:type="external" operaton:topic="print-label">
      <bpmn:incoming>Flow_ComputeShipping_PrintLabel</bpmn:incoming>
      <bpmn:outgoing>Flow_PrintLabel_OrderShipped</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OrderShipped">
      <bpmn:incoming>Flow_PrintLabel_OrderShipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_ChargeCard_error" attachedToRef="ChargeCard">
      <bpmn:outgoing>Flow_Boundary_ChargeCard_error_ReviewPayment</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_PAYMENT_DECLINED" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="ReviewPayment" name="Review the declined payment" operaton:assignee="demo">
      <bpmn:incoming>Flow_Boundary_ChargeCard_error_ReviewPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewPayment_EndEvent_Boundary_ChargeCard_error</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Boundary_ChargeCard_error">
      <bpmn:incoming>Flow_ReviewPayment_EndEvent_Boundary_ChargeCard_error</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_ComputeShipping_timer" cancelActivity="false" attachedToRef="ComputeShipping">
      <bpmn:outgoing>Flow_Boundary_ComputeShipping_timer_NotifyShippingDelay</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="NotifyShippingDelay" name="Notify the shipping delay desk" operaton:class="com.example.checkout.DelayDelegate">
      <bpmn:incoming>Flow_Boundary_ComputeShipping_timer_NotifyShippingDelay</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyShippingDelay_EndEvent_Boundary_ComputeShipping_timer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Boundary_ComputeShipping_timer">
      <bpmn:incoming>Flow_NotifyShippingDelay_EndEvent_Boundary_ComputeShipping_timer</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_PrintLabel_message" attachedToRef="PrintLabel">
      <bpmn:outgoing>Flow_Boundary_PrintLabel_message_ExpediteShipment</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ExpediteRequested" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ExpediteShipment" name="Expedite the shipment" operaton:class="com.example.checkout.ExpediteDelegate">
      <bpmn:incoming>Flow_Boundary_PrintLabel_message_ExpediteShipment</bpmn:incoming>
      <bpmn:outgoing>Flow_ExpediteShipment_EndEvent_Boundary_PrintLabel_message</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Boundary_PrintLabel_message">
      <bpmn:incoming>Flow_ExpediteShipment_EndEvent_Boundary_PrintLabel_message</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OrderReceived_ChargeCard" sourceRef="OrderReceived" targetRef="ChargeCard" />
    <bpmn:sequenceFlow id="Flow_ChargeCard_ComputeShipping" sourceRef="ChargeCard" targetRef="ComputeShipping" />
    <bpmn:sequenceFlow id="Flow_ComputeShipping_PrintLabel" sourceRef="ComputeShipping" targetRef="PrintLabel" />
    <bpmn:sequenceFlow id="Flow_PrintLabel_OrderShipped" sourceRef="PrintLabel" targetRef="OrderShipped" />
    <bpmn:sequenceFlow id="Flow_Boundary_ChargeCard_error_ReviewPayment" sourceRef="Boundary_ChargeCard_error" targetRef="ReviewPayment" />
    <bpmn:sequenceFlow id="Flow_ReviewPayment_EndEvent_Boundary_ChargeCard_error" sourceRef="ReviewPayment" targetRef="EndEvent_Boundary_ChargeCard_error" />
    <bpmn:sequenceFlow id="Flow_Boundary_ComputeShipping_timer_NotifyShippingDelay" sourceRef="Boundary_ComputeShipping_timer" targetRef="NotifyShippingDelay" />
    <bpmn:sequenceFlow id="Flow_NotifyShippingDelay_EndEvent_Boundary_ComputeShipping_timer" sourceRef="NotifyShippingDelay" targetRef="EndEvent_Boundary_ComputeShipping_timer" />
    <bpmn:sequenceFlow id="Flow_Boundary_PrintLabel_message_ExpediteShipment" sourceRef="Boundary_PrintLabel_message" targetRef="ExpediteShipment" />
    <bpmn:sequenceFlow id="Flow_ExpediteShipment_EndEvent_Boundary_PrintLabel_message" sourceRef="ExpediteShipment" targetRef="EndEvent_Boundary_PrintLabel_message" />
  </bpmn:process>
  <bpmn:error id="Error_PAYMENT_DECLINED" name="PAYMENT_DECLINED" errorCode="PAYMENT_DECLINED" operaton:errorMessage="The payment gateway declined the charge" />
  <bpmn:message id="Message_ExpediteRequested" name="ExpediteRequested" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_boundary-task-hosts">
    <bpmndi:BPMNPlane id="BPMNPlane_boundary-task-hosts" bpmnElement="boundary-task-hosts">
      <bpmndi:BPMNShape id="OrderReceived_di" bpmnElement="OrderReceived">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ChargeCard_di" bpmnElement="ChargeCard">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_ChargeCard_error_di" bpmnElement="Boundary_ChargeCard_error">
        <dc:Bounds x="207" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ComputeShipping_di" bpmnElement="ComputeShipping">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_ComputeShipping_timer_di" bpmnElement="Boundary_ComputeShipping_timer">
        <dc:Bounds x="357" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrintLabel_di" bpmnElement="PrintLabel">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_PrintLabel_message_di" bpmnElement="Boundary_PrintLabel_message">
        <dc:Bounds x="507" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderShipped_di" bpmnElement="OrderShipped">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExpediteShipment_di" bpmnElement="ExpediteShipment">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Boundary_PrintLabel_message_di" bpmnElement="EndEvent_Boundary_PrintLabel_message">
        <dc:Bounds x="807" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyShippingDelay_di" bpmnElement="NotifyShippingDelay">
        <dc:Bounds x="475" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Boundary_ComputeShipping_timer_di" bpmnElement="EndEvent_Boundary_ComputeShipping_timer">
        <dc:Bounds x="657" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewPayment_di" bpmnElement="ReviewPayment">
        <dc:Bounds x="325" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Boundary_ChargeCard_error_di" bpmnElement="EndEvent_Boundary_ChargeCard_error">
        <dc:Bounds x="507" y="472" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_OrderReceived_ChargeCard_di" bpmnElement="Flow_OrderReceived_ChargeCard">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ChargeCard_ComputeShipping_di" bpmnElement="Flow_ChargeCard_ComputeShipping">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Boundary_ChargeCard_error_ReviewPayment_di" bpmnElement="Flow_Boundary_ChargeCard_error_ReviewPayment">
        <di:waypoint x="225" y="128" />
        <di:waypoint x="225" y="490" />
        <di:waypoint x="325" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ComputeShipping_PrintLabel_di" bpmnElement="Flow_ComputeShipping_PrintLabel">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Boundary_ComputeShipping_timer_NotifyShippingDelay_di" bpmnElement="Flow_Boundary_ComputeShipping_timer_NotifyShippingDelay">
        <di:waypoint x="375" y="128" />
        <di:waypoint x="375" y="350" />
        <di:waypoint x="475" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PrintLabel_OrderShipped_di" bpmnElement="Flow_PrintLabel_OrderShipped">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Boundary_PrintLabel_message_ExpediteShipment_di" bpmnElement="Flow_Boundary_PrintLabel_message_ExpediteShipment">
        <di:waypoint x="525" y="128" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ExpediteShipment_EndEvent_Boundary_PrintLabel_message_di" bpmnElement="Flow_ExpediteShipment_EndEvent_Boundary_PrintLabel_message">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="807" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotifyShippingDelay_EndEvent_Boundary_ComputeShipping_timer_di" bpmnElement="Flow_NotifyShippingDelay_EndEvent_Boundary_ComputeShipping_timer">
        <di:waypoint x="575" y="350" />
        <di:waypoint x="657" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReviewPayment_EndEvent_Boundary_ChargeCard_error_di" bpmnElement="Flow_ReviewPayment_EndEvent_Boundary_ChargeCard_error">
        <di:waypoint x="425" y="490" />
        <di:waypoint x="507" y="490" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_parcel-dispatch" targetNamespace="http://bpmnscript.io/processes" exporter="BPMNscript" exporterVersion="0.0.0">
  <bpmn:process id="parcel-dispatch" name="Parcel Dispatch" isExecutable="true" operaton:historyTimeToLive="P30D">
    <bpmn:startEvent id="ParcelOrdered">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="weight" label="Parcel weight in kilograms" type="long" />
          <operaton:formField id="parcelValue" label="Declared parcel value" type="long" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ParcelOrdered_CheckAddress</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CheckAddress" name="Check the delivery address" operaton:assignee="demo">
      <bpmn:incoming>Flow_ParcelOrdered_CheckAddress</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckAddress_PackGoods</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="PackGoods" name="Pack the goods">
      <bpmn:incoming>Flow_CheckAddress_PackGoods</bpmn:incoming>
      <bpmn:incoming>Flow_MarkAddressVerified_PackGoods</bpmn:incoming>
      <bpmn:outgoing>Flow_PackGoods_BookCarrier</bpmn:outgoing>
      <bpmn:startEvent id="PackStart">
        <bpmn:outgoing>Flow_PackStart_PickItems</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="PickItems" name="Pick the items from the shelves" operaton:class="com.example.dispatch.PickDelegate">
        <bpmn:incoming>Flow_PackStart_PickItems</bpmn:incoming>
        <bpmn:outgoing>Flow_PickItems_Oversized</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="Oversized">
        <bpmn:incoming>Flow_PickItems_Oversized</bpmn:incoming>
        <bpmn:outgoing>Flow_Oversized_SealParcel</bpmn:outgoing>
        <bpmn:escalationEventDefinition escalationRef="Escalation_OVERSIZED_PARCEL" />
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="SealParcel" name="Seal the parcel" operaton:class="com.example.dispatch.SealDelegate">
        <bpmn:incoming>Flow_Oversized_SealParcel</bpmn:incoming>
        <bpmn:outgoing>Flow_SealParcel_PackDone</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="PackDone">
        <bpmn:incoming>Flow_SealParcel_PackDone</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_PackStart_PickItems" sourceRef="PackStart" targetRef="PickItems" />
      <bpmn:sequenceFlow id="Flow_PickItems_Oversized" sourceRef="PickItems" targetRef="Oversized" />
      <bpmn:sequenceFlow id="Flow_Oversized_SealParcel" sourceRef="Oversized" targetRef="SealParcel" />
      <bpmn:sequenceFlow id="Flow_SealParcel_PackDone" sourceRef="SealParcel" targetRef="PackDone" />
    </bpmn:subProcess>
    <bpmn:callActivity id="BookCarrier" name="Book the carrier" calledElement="carrier-booking">
      <bpmn:extensionElements>
        <operaton:in source="weight" target="weight" />
        <operaton:out source="trackingCode" target="trackingCode" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PackGoods_BookCarrier</bpmn:incoming>
      <bpmn:outgoing>Flow_BookCarrier_HandOverParcel</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="HandOverParcel" name="Hand the parcel to the driver" operaton:assignee="demo">
      <bpmn:incoming>Flow_BookCarrier_HandOverParcel</bpmn:incoming>
      <bpmn:outgoing>Flow_HandOverParcel_ParcelDispatched</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ParcelDispatched">
      <bpmn:incoming>Flow_HandOverParcel_ParcelDispatched</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_CheckAddress_message" attachedToRef="CheckAddress">
      <bpmn:outgoing>Flow_Boundary_CheckAddress_message_MarkAddressVerified</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_AddressVerified" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="MarkAddressVerified" name="Record the external address verification" operaton:class="com.example.dispatch.VerifyDelegate">
      <bpmn:incoming>Flow_Boundary_CheckAddress_message_MarkAddressVerified</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkAddressVerified_PackGoods</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_CheckAddress_timer" cancelActivity="false" attachedToRef="CheckAddress">
      <bpmn:outgoing>Flow_Boundary_CheckAddress_timer_SendAddressReminder</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="SendAddressReminder" name="Remind the clerk about the address" operaton:class="com.example.dispatch.ReminderDelegate">
      <bpmn:incoming>Flow_Boundary_CheckAddress_timer_SendAddressReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_SendAddressReminder_EndEvent_Boundary_CheckAddress_timer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Boundary_CheckAddress_timer">
      <bpmn:incoming>Flow_SendAddressReminder_EndEvent_Boundary_CheckAddress_timer</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_PackGoods_error" attachedToRef="PackGoods">
      <bpmn:outgoing>Flow_Boundary_PackGoods_error_CorrectAddress</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_ADDRESS_REJECTED" operaton:errorCodeVariable="c" operaton:errorMessageVariable="m" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="CorrectAddress" name="Correct the delivery address" operaton:assignee="demo">
      <bpmn:incoming>Flow_Boundary_PackGoods_error_CorrectAddress</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrectAddress_Gateway_parcel-dispatch_8_1_split</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_parcel-dispatch_8_1_split" default="Flow_Gateway_parcel-dispatch_8_1_split_default">
      <bpmn:incoming>Flow_CorrectAddress_Gateway_parcel-dispatch_8_1_split</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_parcel-dispatch_8_1_split_NotifyInsuranceDesk</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_parcel-dispatch_8_1_split_default</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_parcel-dispatch_8_1_join">
      <bpmn:incoming>Flow_NotifyInsuranceDesk_Gateway_parcel-dispatch_8_1_join</bpmn:incoming>
      <bpmn:incoming>Flow_NotifyStandardDesk_Gateway_parcel-dispatch_8_1_join</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_parcel-dispatch_8_1_join_RecordAddressFix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="NotifyInsuranceDesk" name="Notify the insurance desk" operaton:class="com.example.dispatch.InsuranceDelegate">
      <bpmn:incoming>Flow_Gateway_parcel-dispatch_8_1_split_NotifyInsuranceDesk</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyInsuranceDesk_Gateway_parcel-dispatch_8_1_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NotifyStandardDesk" name="Notify the standard desk" operaton:class="com.example.dispatch.StandardDeskDelegate">
      <bpmn:incoming>Flow_Gateway_parcel-dispatch_8_1_split_default</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyStandardDesk_Gateway_parcel-dispatch_8_1_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RecordAddressFix" name="Record the corrected address" operaton:class="com.example.dispatch.RecordFixDelegate">
      <bpmn:incoming>Flow_Gateway_parcel-dispatch_8_1_join_RecordAddressFix</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordAddressFix_EndEvent_Boundary_PackGoods_error</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Boundary_PackGoods_error">
      <bpmn:incoming>Flow_RecordAddressFix_EndEvent_Boundary_PackGoods_error</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_PackGoods_escalation" cancelActivity="false" attachedToRef="PackGoods">
      <bpmn:outgoing>Flow_Boundary_PackGoods_escalation_ArrangeFreight</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Escalation_OVERSIZED_PARCEL" operaton:escalationCodeVariable="e" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="ArrangeFreight" name="Arrange a freight forwarder" operaton:assignee="manager">
      <bpmn:incoming>Flow_Boundary_PackGoods_escalation_ArrangeFreight</bpmn:incoming>
      <bpmn:outgoing>Flow_ArrangeFreight_EndEvent_Boundary_PackGoods_escalation</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Boundary_PackGoods_escalation">
      <bpmn:incoming>Flow_ArrangeFreight_EndEvent_Boundary_PackGoods_escalation</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_BookCarrier_signal" attachedToRef="BookCarrier">
      <bpmn:outgoing>Flow_Boundary_BookCarrier_signal_BookAlternateCarrier</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_CarrierStrike" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="BookAlternateCarrier" name="Book an alternate carrier" operaton:class="com.example.dispatch.AlternateCarrierDelegate">
      <bpmn:incoming>Flow_Boundary_BookCarrier_signal_BookAlternateCarrier</bpmn:incoming>
      <bpmn:outgoing>Flow_BookAlternateCarrier_EndEvent_Boundary_BookCarrier_signal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Boundary_BookCarrier_signal">
      <bpmn:incoming>Flow_BookAlternateCarrier_EndEvent_Boundary_BookCarrier_signal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_HandOverParcel_condition" cancelActivity="false" attachedToRef="HandOverParcel">
      <bpmn:outgoing>Flow_Boundary_HandOverParcel_condition_CallForklift</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${weight &gt; 30}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="CallForklift" name="Call a forklift to the ramp" operaton:class="com.example.dispatch.ForkliftDelegate">
      <bpmn:incoming>Flow_Boundary_HandOverParcel_condition_CallForklift</bpmn:incoming>
      <bpmn:outgoing>Flow_CallForklift_EndEvent_Boundary_HandOverParcel_condition</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Boundary_HandOverParcel_condition">
      <bpmn:incoming>Flow_CallForklift_EndEvent_Boundary_HandOverParcel_condition</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="EventSubProcess_parcel-dispatch_12" triggeredByEvent="true">
      <bpmn:startEvent id="StrikeNoted" isInterrupting="false">
        <bpmn:outgoing>Flow_StrikeNoted_RecordCarrierStrike</bpmn:outgoing>
        <bpmn:signalEventDefinition signalRef="Signal_CarrierStrike" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="RecordCarrierStrike" name="Record the carrier strike" operaton:class="com.example.dispatch.StrikeLogDelegate">
        <bpmn:incoming>Flow_StrikeNoted_RecordCarrierStrike</bpmn:incoming>
        <bpmn:outgoing>Flow_RecordCarrierStrike_StrikeRecorded</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="StrikeRecorded">
        <bpmn:incoming>Flow_RecordCarrierStrike_StrikeRecorded</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_StrikeNoted_RecordCarrierStrike" sourceRef="StrikeNoted" targetRef="RecordCarrierStrike" />
      <bpmn:sequenceFlow id="Flow_RecordCarrierStrike_StrikeRecorded" sourceRef="RecordCarrierStrike" targetRef="StrikeRecorded" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSubProcess_parcel-dispatch_13" triggeredByEvent="true">
      <bpmn:startEvent id="CancelReceived">
        <bpmn:outgoing>Flow_CancelReceived_RollBackDispatch</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_DispatchCancelled" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="RollBackDispatch" name="Roll back the dispatch" operaton:class="com.example.dispatch.RollbackDelegate">
        <bpmn:incoming>Flow_CancelReceived_RollBackDispatch</bpmn:incoming>
        <bpmn:outgoing>Flow_RollBackDispatch_CancelHandled</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="CancelHandled">
        <bpmn:incoming>Flow_RollBackDispatch_CancelHandled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_CancelReceived_RollBackDispatch" sourceRef="CancelReceived" targetRef="RollBackDispatch" />
      <bpmn:sequenceFlow id="Flow_RollBackDispatch_CancelHandled" sourceRef="RollBackDispatch" targetRef="CancelHandled" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_ParcelOrdered_CheckAddress" sourceRef="ParcelOrdered" targetRef="CheckAddress" />
    <bpmn:sequenceFlow id="Flow_CheckAddress_PackGoods" sourceRef="CheckAddress" targetRef="PackGoods" />
    <bpmn:sequenceFlow id="Flow_PackGoods_BookCarrier" sourceRef="PackGoods" targetRef="BookCarrier" />
    <bpmn:sequenceFlow id="Flow_BookCarrier_HandOverParcel" sourceRef="BookCarrier" targetRef="HandOverParcel" />
    <bpmn:sequenceFlow id="Flow_HandOverParcel_ParcelDispatched" sourceRef="HandOverParcel" targetRef="ParcelDispatched" />
    <bpmn:sequenceFlow id="Flow_MarkAddressVerified_PackGoods" sourceRef="MarkAddressVerified" targetRef="PackGoods" />
    <bpmn:sequenceFlow id="Flow_Boundary_CheckAddress_message_MarkAddressVerified" sourceRef="Boundary_CheckAddress_message" targetRef="MarkAddressVerified" />
    <bpmn:sequenceFlow id="Flow_Boundary_CheckAddress_timer_SendAddressReminder" sourceRef="Boundary_CheckAddress_timer" targetRef="SendAddressReminder" />
    <bpmn:sequenceFlow id="Flow_SendAddressReminder_EndEvent_Boundary_CheckAddress_timer" sourceRef="SendAddressReminder" targetRef="EndEvent_Boundary_CheckAddress_timer" />
    <bpmn:sequenceFlow id="Flow_Gateway_parcel-dispatch_8_1_split_NotifyInsuranceDesk" name="parcelValue &#62; 500" sourceRef="Gateway_parcel-dispatch_8_1_split" targetRef="NotifyInsuranceDesk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${parcelValue &gt; 500}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotifyInsuranceDesk_Gateway_parcel-dispatch_8_1_join" sourceRef="NotifyInsuranceDesk" targetRef="Gateway_parcel-dispatch_8_1_join" />
    <bpmn:sequenceFlow id="Flow_Gateway_parcel-dispatch_8_1_split_default" sourceRef="Gateway_parcel-dispatch_8_1_split" targetRef="NotifyStandardDesk" />
    <bpmn:sequenceFlow id="Flow_NotifyStandardDesk_Gateway_parcel-dispatch_8_1_join" sourceRef="NotifyStandardDesk" targetRef="Gateway_parcel-dispatch_8_1_join" />
    <bpmn:sequenceFlow id="Flow_CorrectAddress_Gateway_parcel-dispatch_8_1_split" sourceRef="CorrectAddress" targetRef="Gateway_parcel-dispatch_8_1_split" />
    <bpmn:sequenceFlow id="Flow_Gateway_parcel-dispatch_8_1_join_RecordAddressFix" sourceRef="Gateway_parcel-dispatch_8_1_join" targetRef="RecordAddressFix" />
    <bpmn:sequenceFlow id="Flow_Boundary_PackGoods_error_CorrectAddress" sourceRef="Boundary_PackGoods_error" targetRef="CorrectAddress" />
    <bpmn:sequenceFlow id="Flow_RecordAddressFix_EndEvent_Boundary_PackGoods_error" sourceRef="RecordAddressFix" targetRef="EndEvent_Boundary_PackGoods_error" />
    <bpmn:sequenceFlow id="Flow_Boundary_PackGoods_escalation_ArrangeFreight" sourceRef="Boundary_PackGoods_escalation" targetRef="ArrangeFreight" />
    <bpmn:sequenceFlow id="Flow_ArrangeFreight_EndEvent_Boundary_PackGoods_escalation" sourceRef="ArrangeFreight" targetRef="EndEvent_Boundary_PackGoods_escalation" />
    <bpmn:sequenceFlow id="Flow_Boundary_BookCarrier_signal_BookAlternateCarrier" sourceRef="Boundary_BookCarrier_signal" targetRef="BookAlternateCarrier" />
    <bpmn:sequenceFlow id="Flow_BookAlternateCarrier_EndEvent_Boundary_BookCarrier_signal" sourceRef="BookAlternateCarrier" targetRef="EndEvent_Boundary_BookCarrier_signal" />
    <bpmn:sequenceFlow id="Flow_Boundary_HandOverParcel_condition_CallForklift" sourceRef="Boundary_HandOverParcel_condition" targetRef="CallForklift" />
    <bpmn:sequenceFlow id="Flow_CallForklift_EndEvent_Boundary_HandOverParcel_condition" sourceRef="CallForklift" targetRef="EndEvent_Boundary_HandOverParcel_condition" />
  </bpmn:process>
  <bpmn:error id="Error_ADDRESS_REJECTED" name="ADDRESS_REJECTED" errorCode="ADDRESS_REJECTED" operaton:errorMessage="The carrier rejected the delivery address" />
  <bpmn:escalation id="Escalation_OVERSIZED_PARCEL" name="OVERSIZED_PARCEL" escalationCode="OVERSIZED_PARCEL" />
  <bpmn:message id="Message_AddressVerified" name="AddressVerified" />
  <bpmn:message id="Message_DispatchCancelled" name="DispatchCancelled" />
  <bpmn:signal id="Signal_CarrierStrike" name="CarrierStrike" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_parcel-dispatch">
    <bpmndi:BPMNPlane id="BPMNPlane_parcel-dispatch" bpmnElement="parcel-dispatch">
      <bpmndi:BPMNShape id="ParcelOrdered_di" bpmnElement="ParcelOrdered">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckAddress_di" bpmnElement="CheckAddress">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CheckAddress_message_di" bpmnElement="Boundary_CheckAddress_message">
        <dc:Bounds x="640.3333333333334" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CheckAddress_timer_di" bpmnElement="Boundary_CheckAddress_timer">
        <dc:Bounds x="673.6666666666666" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PackGoods_di" bpmnElement="PackGoods" isExpanded="true">
        <dc:Bounds x="925" y="30" width="850" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_PackGoods_error_di" bpmnElement="Boundary_PackGoods_error">
        <dc:Bounds x="1190.3333333333333" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_PackGoods_escalation_di" bpmnElement="Boundary_PackGoods_escalation">
        <dc:Bounds x="1473.6666666666665" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookCarrier_di" bpmnElement="BookCarrier">
        <dc:Bounds x="1825" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_BookCarrier_signal_di" bpmnElement="Boundary_BookCarrier_signal">
        <dc:Bounds x="1857" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandOverParcel_di" bpmnElement="HandOverParcel">
        <dc:Bounds x="1975" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_HandOverParcel_condition_di" bpmnElement="Boundary_HandOverParcel_condition">
        <dc:Bounds x="2007" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParcelDispatched_di" bpmnElement="ParcelDispatched">
        <dc:Bounds x="2157" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallForklift_di" bpmnElement="CallForklift">
        <dc:Bounds x="2125" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Boundary_HandOverParcel_condition_di" bpmnElement="EndEvent_Boundary_HandOverParcel_condition">
        <dc:Bounds x="2307" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookAlternateCarrier_di" bpmnElement="BookAlternateCarrier">
        <dc:Bounds x="1975" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Boundary_BookCarrier_signal_di" bpmnElement="EndEvent_Boundary_BookCarrier_signal">
        <dc:Bounds x="2157" y="472" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArrangeFreight_di" bpmnElement="ArrangeFreight">
        <dc:Bounds x="1825" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Boundary_PackGoods_escalation_di" bpmnElement="EndEvent_Boundary_PackGoods_escalation">
        <dc:Bounds x="2007" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CorrectAddress_di" bpmnElement="CorrectAddress">
        <dc:Bounds x="1825" y="730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_parcel-dispatch_8_1_split_di" bpmnElement="Gateway_parcel-dispatch_8_1_split" isMarkerVisible="true">
        <dc:Bounds x="2000" y="745" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyInsuranceDesk_di" bpmnElement="NotifyInsuranceDesk">
        <dc:Bounds x="2125" y="730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_parcel-dispatch_8_1_join_di" bpmnElement="Gateway_parcel-dispatch_8_1_join" isMarkerVisible="true">
        <dc:Bounds x="2300" y="745" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordAddressFix_di" bpmnElement="RecordAddressFix">
        <dc:Bounds x="2425" y="730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Boundary_PackGoods_error_di" bpmnElement="EndEvent_Boundary_PackGoods_error">
        <dc:Bounds x="2607" y="752" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendAddressReminder_di" bpmnElement="SendAddressReminder">
        <dc:Bounds x="775" y="870" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Boundary_CheckAddress_timer_di" bpmnElement="EndEvent_Boundary_CheckAddress_timer">

// Nested sub-process round-trip fixture: an order-fulfillment process whose
// stages are grouped into embedded sub-processes. It exercises, in one program,
// every shape the containment feature must round-trip:
//
//   - explicit top-level start/end and plain tasks before and after the nesting;
//   - a sub-process with an IMPLICIT start/end wrapping an if/else;
//   - a labeled sub-process with an EXPLICIT start/end wrapping a while loop;
//   - a two-level nested sub-process (a sub-process inside that sub-process).
//
// Every named node carries an explicit id so the round-trip can assert authored
// ids survive at their correct container depth. See README.md.

process order-fulfillment {
  var amount: number
  var retries: number

  start OrderReceived
  user RecordOrder(label: "Record order", assignee: "demo")

  subprocess Payment(label: "Handle payment") {
    if (amount > 1000) {
      user ManualReview(label: "Manual review", assignee: "manager")
    } else {
      service AutoCharge(label: "Auto-charge card", class: "com.example.demo.LogDelegate")
    }
  }

  subprocess Fulfillment(label: "Fulfill the order") {
    start FulfillmentStart
    while (retries < 3) {
      service ReserveStock(label: "Reserve stock", class: "com.example.demo.LogDelegate")
    }
    subprocess Shipping(label: "Ship the parcel") {
      user PackParcel(label: "Pack parcel", assignee: "demo")
      service DispatchParcel(label: "Dispatch parcel", class: "com.example.demo.LogDelegate")
    }
    end FulfillmentDone
  }

  user CloseOrder(label: "Close order", assignee: "demo")
  end OrderClosed
}

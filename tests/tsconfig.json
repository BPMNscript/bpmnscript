{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "out",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "references": [
    { "path": "../packages/language/tsconfig.src.json" },
    { "path": "../packages/transform/tsconfig.json" }
  ],
  "include": [
    "fixtures/**/*.ts",
    "helpers/**/*.ts",
    "vitest.config.ts",
    "**/*.test.ts"
  ],
  "exclude": ["out/**", "node_modules/**"]
}
